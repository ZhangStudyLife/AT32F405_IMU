#include <windows.h>

1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/assets/app.manifest"
100 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/app.ico"
101 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/board.bin"
102 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/JSON-LICENSE.txt"

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "IMUStudio\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "ProductName", "IMUStudio\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
            VALUE "OriginalFilename", "IMUStudio.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
